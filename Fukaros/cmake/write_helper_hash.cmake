if(NOT HELPER OR NOT OUT)
    message(FATAL_ERROR "HELPER and OUT are required")
endif()
file(SHA256 "${HELPER}" digest)
string(TOUPPER "${digest}" digest)
get_filename_component(dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${dir}")
set(content "#pragma once\n#define FR_VIRTUAL_DISPLAY_HELPER_SHA256 \"${digest}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" current)
else()
    set(current "")
endif()
if(NOT current STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
