          <string>已保存上次的扩展屏位置</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="inheritPosition">
         <property name="text">
          <string>继承之前屏幕位置</string>
         </property>
         <property name="default">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="reconfigurePosition">
         <property name="text">
          <string>重新配置屏幕位置</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="configurePage">
      <layout class="QVBoxLayout" name="configureLayout">
       <item>
        <layout class="QHBoxLayout" name="positionHelpRow">
         <item>
          <widget class="QLabel" name="configurePositionTitle">
           <property name="text">
            <string>在系统显示设置中调整屏幕位置</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QVBoxLayout" name="positionHelpLayout">
           <property name="spacing">
            <number>0</number>
           </property>
           <property name="leftMargin">
            <number>0</number>
           </property>
           <property name="topMargin">
            <number>0</number>
           </property>
           <property name="rightMargin">
            <number>0</number>
           </property>
           <property name="bottomMargin">
            <number>0</number>
           </property>
           <item>
            <spacer name="positionHelpSpring">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="sizeType">
              <enum>QSizePolicy::Minimum</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>0</width>
               <height>16</height>
              </size>
             </property>
            </spacer>
           </item>
           <item>
            <widget class="StepHelpButton" name="positionHelp">
             <property name="helpTitle" stdset="0">
              <string>扩展屏位置操作步骤</string>
             </property>
             <property name="steps" stdset="0">
              <string>1. 在 Windows 显示设置中点击“标识”，找到平板扩展屏。
2. 拖动平板对应的屏幕方块，放在电脑屏幕的左、右、上或下。
3. 点击“应用”，必要时选择保留更改。
4. 返回 Fukaros，点击“完成并记住位置”开始投屏。
5. 下次连接可继承之前位置，或重新打开此页面配置。
6. 如需在投屏中调整位置，请先停止，再重新连接。</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QPushButton" name="openDisplaySettings">
         <property name="text">
          <string>打开显示设置</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="finishPosition">
         <property name="text">
          <string>完成并记住位置</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
