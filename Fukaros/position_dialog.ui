 <class>PositionDialog</class>
 <widget class="QDialog" name="PositionDialog">
  <property name="windowTitle">
   <string>扩展屏位置</string>
  </property>
  <property name="minimumSize">
   <size>
    <width>280</width>
    <height>0</height>
   </size>
  </property>
  <layout class="QVBoxLayout" name="positionLayout">
   <property name="spacing">
    <number>12</number>
   </property>
   <item>
    <widget class="QStackedWidget" name="positionPages">
     <widget class="QWidget" name="choicePage">
      <layout class="QVBoxLayout" name="choiceLayout">
       <item>
        <widget class="QLabel" name="savedPositionTitle">
