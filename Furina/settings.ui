                <bool>true</bool>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QLabel" name="deviceHint">
             <property name="text">
              <string>此设备码用于标识本机；电脑端使用 ADB 序列号，可通过刷新 USB 设备获取。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="usbHint">
             <property name="text">
              <string>USB 无需填写 IP。打开 USB 调试并允许电脑授权，电脑设置选择 USB 即可连接。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="wifiPage">
          <attribute name="title">
           <string>Wi-Fi 无线</string>
          </attribute>
          <layout class="QVBoxLayout" name="wifiPageLayout">
           <item>
            <layout class="QFormLayout" name="wifiPageForm">
             <item row="0" column="0">
              <widget class="QLabel" name="hostLabel">
