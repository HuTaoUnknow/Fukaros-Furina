         </item>
         <item row="2" column="1">
          <widget class="QLineEdit" name="token">
           <property name="placeholderText">
            <string>至少 6 位</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QFrame" name="settingsSeparator">
         <property name="frameShape">
          <enum>QFrame::HLine</enum>
         </property>
