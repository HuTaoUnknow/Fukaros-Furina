<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
 <class>SettingsDialog</class>
 <widget class="QDialog" name="SettingsDialog">
  <property name="windowTitle">
   <string>连接设置</string>
  </property>
  <layout class="QVBoxLayout" name="dialogLayout">
   <item>
    <widget class="QLabel" name="sessionSettingsHint">
     <property name="text">
      <string>投屏期间仅清晰度可调整，点击停止后可修改连接参数。
Only resolution can change while casting. Press Stop to edit connection settings.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QScrollArea" name="settingsScroll">
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <property name="horizontalScrollBarPolicy">
      <enum>Qt::ScrollBarAlwaysOff</enum>
     </property>
     <widget class="QWidget" name="settingsContents">
      <layout class="QVBoxLayout" name="settingsLayout">
       <item>
        <widget class="QGroupBox" name="pairingGroup">
         <property name="title">
          <string>配对设置（USB / Wi-Fi 共用）</string>
         </property>
         <layout class="QVBoxLayout" name="pairingGroupLayout">
          <item>
