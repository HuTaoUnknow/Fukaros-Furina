            </item>
            <item row="0" column="1">
             <widget class="QLineEdit" name="token">
              <property name="placeholderText">
               <string>至少 6 位，与对端一致</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QTabWidget" name="connectionTabs">
         <widget class="QWidget" name="usbPage">
          <attribute name="title">
           <string>USB 有线</string>
          </attribute>
          <layout class="QVBoxLayout" name="usbPageLayout">
           <item>
            <layout class="QFormLayout" name="usbPageForm">
             <item row="0" column="0">
              <widget class="QLabel" name="serialLabel">
               <property name="text">
                <string>本机设备码</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="serial">
