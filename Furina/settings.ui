                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="refreshAddresses">
                  <property name="text">
                   <string>刷新 IP</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
